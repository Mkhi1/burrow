{
  "name": "burrow",
  "productName": "Burrow",
  "version": "0.3.5",
  "description": "A calm terminal home for your coding agents",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win",
    "icon": "electron build/make-icon.js",
    "vendor": "esbuild build/codemirror-entry.js --bundle --minify --format=iife --global-name=CM --outfile=src/renderer/vendor/codemirror.js",
    "prestart": "npm run vendor",
    "predist": "npm run vendor"
  },
  "build": {
    "appId": "app.burrow.terminal",
    "productName": "Burrow",
    "copyright": "Developed by MK",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "artifactName": "Burrow-Setup-${version}.${ext}"
    },
    "files": [
      "src/**",
      "package.json",
      "node_modules/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "src/main/usageWorker.js",
      "src/main/usageParse.js"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Mkhi1",
        "repo": "burrow"
      }
    ]
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "marked": "^18.1.3",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "author": "MK",
  "license": "MIT",
  "homepage": "https://github.com/Mkhi1/burrow",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mkhi1/burrow.git"
  },
  "keywords": [
    "terminal",
    "claude-code",
    "codex",
    "ai-agents",
    "electron",
    "windows"
  ]
}
