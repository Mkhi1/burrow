{
  "name": "burrow",
  "productName": "Burrow",
  "version": "0.1.0",
  "description": "A calm terminal home for your coding agents",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win",
    "icon": "electron build/make-icon.js"
  },
  "build": {
    "appId": "app.burrow.terminal",
    "productName": "Burrow",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "src/**",
      "package.json",
      "node_modules/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "src/main/usageWorker.js",
      "src/main/usageParse.js"
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "author": "Mkhi1",
  "license": "MIT",
  "homepage": "https://github.com/Mkhi1/burrow",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mkhi1/burrow.git"
  },
  "keywords": [
    "terminal",
    "claude-code",
    "codex",
    "ai-agents",
    "electron",
    "windows"
  ]
}
